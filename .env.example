# CommandCore server
COMMANDCORE_HOST=0.0.0.0
COMMANDCORE_PORT=8787
COMMANDCORE_DB=/data/commandcore.sqlite3

# Generate unique values for every deployment.
COMMANDCORE_API_TOKEN=
COMMANDCORE_PANEL_SESSION_SECRET=

# Fail closed by default. For a controlled first-time onboarding window, an
# operator may deliberately enable bootstrap, then disable it after OAuth/OIDC is
# configured and tested. Recovery should stay disabled outside explicit recovery.
COMMANDCORE_PUBLIC_BOOTSTRAP_ENABLED=false
COMMANDCORE_RECOVERY_ENABLED=false
COMMANDCORE_BOOTSTRAP_SUBJECT=bootstrap-admin

# Replace the example host with the deployment's canonical HTTPS origin.
COMMANDCORE_PUBLIC_BASE_URL=https://commandcore.example.com
COMMANDCORE_MCP_BASE_URL=https://commandcore.example.com/mcp
COMMANDCORE_AGENT_BASE_URL=wss://commandcore.example.com/agent

COMMANDCORE_ENROLLMENT_TTL_SECONDS=600
COMMANDCORE_SELECTION_TTL_SECONDS=86400
COMMANDCORE_HEARTBEAT_TIMEOUT_SECONDS=45
COMMANDCORE_MAX_JOB_OUTPUT_BYTES=1048576
COMMANDCORE_MAX_TRANSFER_BYTES=10485760
COMMANDCORE_AUTO_APPROVE_ENROLLMENT=false
COMMANDCORE_PANEL_SESSION_TTL_SECONDS=28800
COMMANDCORE_PANEL_COOKIE_SECURE=true

# OAuth/OIDC resource-server mode.
COMMANDCORE_OAUTH_ENABLED=false
COMMANDCORE_OAUTH_ALGORITHMS=RS256
COMMANDCORE_PANEL_OAUTH_CLIENT_ID=
COMMANDCORE_OAUTH_ISSUER=https://auth.example.com/
COMMANDCORE_OAUTH_AUDIENCE=https://commandcore.example.com/mcp
COMMANDCORE_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
COMMANDCORE_OAUTH_AUTHORIZATION_SERVERS=https://auth.example.com

# Agent release information.
COMMANDCORE_RECOMMENDED_AGENT_VERSION=0.9.0-rc7
COMMANDCORE_AGENT_UPDATE_MANIFEST_URL=

# Server-side ceiling. This can only reduce authority; it must not enable
# FULL_CONTROL on a device that did not opt in locally.
COMMANDCORE_AGENT_MAX_PERMISSION_PROFILE=STANDARD

# Experimental. Do not advertise desktop control as supported merely by enabling it.
COMMANDCORE_DESKTOP_ENABLED=false
